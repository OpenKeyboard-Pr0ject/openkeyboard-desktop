{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenKeyboard",
  "version": "0.1.0",
  "identifier": "dev.openkeyboard.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OpenKeyboard",
        "width": 640,
        "height": 900,
        "minWidth": 420,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon-32.png", "icons/icon-128.png", "icons/icon.ico"]
  }
}
